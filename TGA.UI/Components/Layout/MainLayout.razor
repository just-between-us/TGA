@inherits LayoutComponentBase
@inject ITelegramOtherUpdateNotifier OtherUpdates
@inject ISnackbar Snackbar
@using TGA.Contract.Abstractions
@using TGA.Contract.DTOs
@using TGA.Domain.Enums
@using TGA.UI.Shared.TgaAnimatedBackground
@using TGA.UI.Shared.TgaLogo
@inject IConnectionStatusService ConnectionStatus
@implements IDisposable

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"/>
        <TgaLogo />
        <MudChip Icon="@StatusIcon" Class="mx-8" Variant="Variant.Text" Color="StatusColor" T="string">
            @StatusLabel
        </MudChip>
        <MudSpacer/>
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle"/>
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End"/>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>
    <MudMainContent Class="tga-main-content pt-16 pa-4">
         <TgaAnimatedBackground IsDarkMode="_isDarkMode"/>
         <div class="tga-main-content-body">
              @Body
         </div>
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
        ConnectionStatus.StateChanged += OnConnectionStateChanged;
        OtherUpdates.OtherUpdateReceived += OnOtherUpdateReceived;
    }

    private void OnConnectionStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
    
    private void OnOtherUpdateReceived(TelegramOtherUpdateDto update)
    {
        InvokeAsync(() =>
        {
            Snackbar.Add($"{update.TypeName}: {update.Description}", Severity.Info);
        });
    }
    
    public void Dispose()
    {
        ConnectionStatus.StateChanged -= OnConnectionStateChanged;
        OtherUpdates.OtherUpdateReceived -= OnOtherUpdateReceived;
    }

    private string StatusLabel => ConnectionStatus.State switch
    {
        ConnectionState.Connecting => "Соединение...",
        ConnectionState.Updating => "Обновление...",
        ConnectionState.Connected => ConnectionStatus.UserDisplayName ?? "Подключено",
        ConnectionState.Disconnected => "Не подключено",
        _ => ""
    };

    private string StatusIcon => ConnectionStatus.State switch
    {
        ConnectionState.Connecting => Icons.Material.Filled.SyncProblem,
        ConnectionState.Updating => Icons.Material.Filled.Sync,
        ConnectionState.Connected => Icons.Material.Filled.CheckCircle,
        ConnectionState.Disconnected => Icons.Material.Filled.CloudOff,
        _ => Icons.Material.Filled.HelpOutline
    };

    private Color StatusColor => ConnectionStatus.State switch
    {
        ConnectionState.Connecting => Color.Warning,
        ConnectionState.Updating => Color.Info,
        ConnectionState.Connected => Color.Success,
        ConnectionState.Disconnected => Color.Error,
        _ => Color.Default
    };

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#2b7be4",          
        Secondary = "#FF9800",
        Black = "#110e2d",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#0083FF",
        Secondary = "#FF9800",
        Background = "#121212",
        Surface = "#1E1E1E",
        BackgroundGray = "#2A2A2A",
        DrawerBackground = "#1E1E1E",
        TextPrimary = "#E0E0E0",
        TextSecondary = "#A0A0A0",
        AppbarText = "#E0E0E0",
        DrawerIcon = "#A0A0A0",
        DrawerText = "#A0A0A0",
        TextDisabled = "#FFFFFF4D",
        AppbarBackground = "rgba(18, 18, 18, 0.8)",
        ActionDefault = "#A0A0A0",
        ActionDisabled = "#A0A0A04D",
        ActionDisabledBackground = "#A0A0A04D",
        GrayLight = "#333333",
        GrayLighter = "#2A2A2A",
        LinesDefault = "#333333",
        TableLines = "#333333",
        Divider = "#2A2A2A",
        OverlayLight = "#1E1E1E80",
        Info = "#4A86FF",
        Success = "#3DCB6C",
        Warning = "#FFB545",
        Error = "#FF3F5F",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };


}