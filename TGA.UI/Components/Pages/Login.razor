@page "/login"
@using TGA.Contract.Abstractions
@inject ITelegramAuthService Auth
@inject ITelegramMessageService MessageService
@inject NavigationManager NavigationManager
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
        <MudCard Class="pa-6" Elevation="4" Style="width: 500px">
            <MudCardContent>
                <div class="d-flex align-center mb-6">
                    <MudIcon Icon="@GetIcon()" Color="Color.Primary" Size="Size.Large" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h5" Color="Color.Primary">@GetTitle()</MudText>
                    </div>
                </div>

                @if (Auth.CurrentStep == AuthStep.NotStarted)
                {
                    <MudText Typo="Typo.body1" Class="mb-6">
                        Для работы приложения необходимо подключить ваш аккаунт Telegram.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="Icons.Material.Filled.Telegram"
                               FullWidth="true" OnClick="Start" Size="Size.Large">
                        Войти через Telegram
                    </MudButton>
                }
                else if (Auth.CurrentStep is AuthStep.WaitingPhone or AuthStep.WaitingCode or AuthStep.WaitingPassword)
                {
                    <MudTextField @bind-Value="_input"
                                  Label="@Label"
                                  InputType="@InputType"
                                  Immediate="true"
                                  Adornment="@GetAdornment()"
                                  OnKeyDown="@(e => { if (e.Key == "Enter") Submit(); })"
                                  AutoFocus="true"
                                  Class="mb-6" />

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                               FullWidth="true" OnClick="Submit" Size="Size.Large">
                        Далее
                    </MudButton>

                    @if (Auth.CurrentStep == AuthStep.WaitingCode)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="m-4 text-center">
                            Код отправлен в Telegram. Если не пришёл, проверьте номер телефона или начните заново.
                        </MudText>
                    }
                }
                else if (Auth.CurrentStep == AuthStep.Done)
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3">Успешно подключено!</MudAlert>
                    <MudCheckBox @bind-Value="_loadAvatars" Color="Color.Primary" Class="mb-3">
                        Загружать аватары контактов
                    </MudCheckBox>
                    <MudButton Color="Color.Primary" FullWidth="true" OnClick="SyncAndContinue" Disabled="@_syncing">
                        @(_syncing ? "Синхронизация диалогов..." : "Загрузить диалоги")
                    </MudButton>
                }
                @if (_syncError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">Ошибка синхронизации: @_syncError</MudAlert>
                }
                else if (Auth.CurrentStep == AuthStep.Error)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-6">
                        @Auth.ErrorMessage
                    </MudAlert>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="m-4 text-center">
                        Подождите пару секунд и войдите повторно
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               FullWidth="true" OnClick="Start" Size="Size.Large">
                        Попробовать снова
                    </MudButton>
                }
            </MudCardContent>
        </MudCard>
</MudContainer>

@code {
    private string _input = string.Empty;
    private string? _syncError = null;
    private bool _loading;
    private bool _syncing;
    private bool _loadAvatars = true;

    protected override void OnInitialized()
    {
        Auth.StateChanged += OnChanged;
    }

    private string GetIcon() => Auth.CurrentStep switch
    {
        AuthStep.NotStarted => Icons.Material.Filled.Message,
        AuthStep.WaitingPhone => Icons.Material.Filled.Phone,
        AuthStep.WaitingCode => Icons.Material.Filled.Sms,
        AuthStep.WaitingPassword => Icons.Material.Filled.Key,
        AuthStep.Done => Icons.Material.Filled.Message,
        AuthStep.Error => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.Help
    };

    private string GetTitle() => Auth.CurrentStep switch
    {
        AuthStep.NotStarted => "Подключение аккаунта",
        AuthStep.WaitingPhone => "Введите номер телефона",
        AuthStep.WaitingCode => "Введите код подтверждения",
        AuthStep.WaitingPassword => "Введите пароль 2FA",
        AuthStep.Done => "Готово!",
        AuthStep.Error => "Ошибка",
        _ => "Авторизация"
    };

    private string Label => Auth.CurrentStep switch
    {
        AuthStep.WaitingPhone => "Номер телефона (+79998887777)",
        AuthStep.WaitingCode => "Код из Telegram",
        AuthStep.WaitingPassword => "Пароль 2FA",
        _ => ""
    };

    private InputType InputType =>
        Auth.CurrentStep == AuthStep.WaitingPassword ? InputType.Password : InputType.Text;

    private Adornment GetAdornment() => Adornment.Start;

    private void Start() => _ = Auth.StartAddAccountAsync();

    private void Submit()
    {
        Auth.SubmitInput(_input);
        _input = string.Empty;
    }
    
    private async Task SyncAndContinue()
    {
        _syncing = true;
        _syncError = null;
        StateHasChanged();

        try
        {
            await MessageService.SyncDialogsAsync(_loadAvatars);
            MessageService.StartMonitoring();
            NavigationManager.NavigateTo("/chats");
        }
        catch (Exception ex)
        {
            _syncError = ex.Message;
        }
        finally
        {
            _syncing = false;
            StateHasChanged();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.StateChanged -= OnChanged;
}